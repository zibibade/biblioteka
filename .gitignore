# Nigdy do gita (sekrety i pliki z maszyny/serwera):
.env
# hasla DB + haslo dostepu -> w repo jest config.example.php
config.php
# okladki i zdjecia egzemplarzy (zyja tylko na serwerze)
uploads/*
# ...ale plik .htaccess w uploads/ jedzie z repo (blokuje listowanie katalogu)
!uploads/.htaccess
*.log
