/vendor/
.phpunit.cache

# kopia konfiguracji z prawdziwymi haslami — nigdy do repo (wycieklo by na GitHub)
config_modified.php

# zasady dla agenta kodujacego: lokalny symlink do pliku poza repozytorium
AGENTS.md

