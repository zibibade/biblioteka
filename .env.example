# Skopiuj do .env i ustaw własne wartości. Plik .env jest w .gitignore.
#
# Hasła do bazy i do aplikacji nie mają nic wspólnego z tymi z hostingu —
# to osobna, lokalna instalacja.

# port aplikacji na hoście (http://localhost:8080)
BIB_PORT=8080

# hasło do aplikacji (logowanie) — minimum 8 znaków
BIB_APP_PASSWORD=zmien-to-haslo

# baza
BIB_DB_NAME=biblioteka
BIB_DB_USER=biblioteka
BIB_DB_PASS=zmien-to-haslo-bazy
BIB_DB_ROOT_PASS=zmien-to-haslo-roota

# opcjonalnie: klucz Google Books API
BIB_GOOGLE_KEY=
